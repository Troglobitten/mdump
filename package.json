{
  "name": "mdump",
  "version": "1.6.1",
  "private": true,
  "description": "Self-hosted markdown note-taking application with WYSIWYG editing",
  "scripts": {
    "dev": "concurrently \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "build": "pnpm --filter shared build && pnpm --filter client build && pnpm --filter server build",
    "build:client": "pnpm --filter client build",
    "build:server": "pnpm --filter server build",
    "start": "pnpm --filter server start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write \"**/*.{ts,tsx,vue,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,json,css,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.4",
  "pnpm": {
    "overrides": {
      "@milkdown/ctx": "^7.21.2"
    }
  }
}
